#!/bin/sh
# preview: open an asset in Remotion Studio; saving the .tsx refreshes the view.
# Usage: preview <asset>.tsx
set -e
[ $# -eq 1 ] || { echo "usage: preview <asset>.tsx" >&2; exit 1; }
abs="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
cd "$(dirname "$0")/../runtimes/remotion"
[ -d node_modules ] || npm install --no-audit --no-fund
ASSET="$abs" exec npx remotion studio index.tsx
