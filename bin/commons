#!/usr/bin/env python3
"""commons: search and download images from Wikimedia Commons, recording source and license.

  commons search <query> [count]          list candidates: title, size, license, author
  commons get "File:<title>" <dest.jpg>   download (long side up to 2400 px) and write <dest>.md
"""
import datetime, html, json, re, sys, urllib.parse, urllib.request
from pathlib import Path

API = "https://commons.wikimedia.org/w/api.php"
UA = "media-toolkit/0.1 (personal content tool)"  # Wikimedia requires a User-Agent


def call(**params):
    url = API + "?" + urllib.parse.urlencode({"action": "query", "format": "json", **params})
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=30) as r:
        return json.load(r)


def clean(s):  # extmetadata values are HTML: strip tags and hidden duplicate text
    s = re.sub(r'<span style="display: none;">.*?</span>', "", str(s or ""))
    return html.unescape(re.sub(r"<[^>]+>", "", s)).strip()


def info(page):
    i = page["imageinfo"][0]
    m = {k: clean(v.get("value")) for k, v in i["extmetadata"].items()}
    return i, m


def search(q, n=10):
    d = call(generator="search", gsrnamespace=6, gsrsearch=f"{q} filetype:bitmap", gsrlimit=n,
             prop="imageinfo", iiprop="url|extmetadata|size")
    pages = sorted(d.get("query", {}).get("pages", {}).values(), key=lambda p: p["index"])
    if not pages:
        print("No results. Try English or the original-language name."); return
    for k, p in enumerate(pages, 1):
        i, m = info(p)
        print(f"{k:2}. {p['title']}  {i['width']}x{i['height']}  [{m.get('LicenseShortName', '?')}]")
        print(f"    author: {m.get('Artist', '?')[:60]}   {i['descriptionurl']}")


def get(title, dest):
    d = call(titles=title, prop="imageinfo|categories", iiprop="url|extmetadata|size", iiurlwidth=2400, cllimit="max")
    page = next(iter(d["query"]["pages"].values()))
    if "imageinfo" not in page:
        sys.exit(f"Not found: {title}")
    i, m = info(page)
    # Scans often carry two licenses (public-domain work + CC BY-SA photo); LicenseShortName reports one, so check categories too.
    lic = [c["title"][9:] for c in page.get("categories", []) if re.match(r"Category:(CC|PD|GFDL|Public domain)", c["title"])]
    credit = m.get("AttributionRequired") == "true" or any(c.startswith("CC-BY") for c in lic)
    dest = Path(dest)
    req = urllib.request.Request(i.get("thumburl") or i["url"], headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=120) as r:
        dest.write_bytes(r.read())
    need = "credit required" if credit else "no credit required"
    author = m.get("Artist", "unknown")
    dest.with_suffix(".md").write_text(f"""# {dest.name}

- Source: Wikimedia Commons, {i['descriptionurl']}
- Title: {page['title']}
- Description: {m.get('ImageDescription', '')[:120]}
- Author: {author}
- License: {m.get('LicenseShortName', 'unknown')} ({need}) {m.get('LicenseUrl', '')}
- License categories: {', '.join(lic) or 'none'} (if several, follow the strictest; confirm on the source page before publishing)
- Credit line: {author} / {', '.join(c for c in lic if c.startswith('CC-BY')) or m.get('LicenseShortName', '')} / Wikimedia Commons
- Retrieved: {datetime.date.today()}
- Original size: {i['width']}x{i['height']}
""", encoding="utf-8")
    print(f"{dest}  [{m.get('LicenseShortName', '?')}, {need}]")


if __name__ == "__main__":
    a = sys.argv[1:]
    if len(a) >= 2 and a[0] == "search":
        search(a[1], int(a[2]) if len(a) > 2 else 10)
    elif len(a) == 3 and a[0] == "get":
        get(a[1], a[2])
    else:
        sys.exit(__doc__)
